{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "node --test --test-isolation=none",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1",
    "test:watch": "NODE_ENV=test node --test --watch",
    "devop": "NODE_ENV=development yarn sequelize db:drop && NODE_ENV=development yarn sequelize db:create && NODE_ENV=development yarn sequelize db:migrate && NODE_ENV=development yarn sequelize db:seed:all ",
    "prod": "NODE_ENV=production yarn sequelize db:migrate:undo:all && NODE_ENV=production yarn sequelize db:migrate && NODE_ENV=production yarn sequelize db:seed:all"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "file-type": "^21.3.4",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.5",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "rss-parser": "^3.13.0",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.5",
    "ws": "^8.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.3",
